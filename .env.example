# Modelo de configuração — copie para .env e preencha com as chaves reais.
# O .env real fica fora do controle de versão (ver .gitignore) e NUNCA
# deve ser publicado junto com o site.

# Geração de thumbnails (Gemini)
GEMINI_API_KEY=cole_sua_chave_aqui

# Pesquisa de thumbnails concorrentes (opcional)
SCRAPECREATORS_API_KEY=cole_sua_chave_aqui
